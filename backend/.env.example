# OutHere backend configuration. Copy to .env and fill in.
# Storage is picked in this order (see SUPABASE.md):
#   1. SUPABASE_DB_URL set  -> Supabase Postgres
#   2. MONGO_URL set        -> MongoDB
#   3. neither              -> in-memory mock (local dev only, data is lost on restart)

SUPABASE_DB_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
# MONGO_URL=mongodb://localhost:27017
DB_NAME=outere_db
