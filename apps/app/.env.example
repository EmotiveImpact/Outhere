# The web server reads these from process.env when it runs, not when it is
# built (it renders on the server, so import.meta.env is not used). One build
# can therefore point at any project. Set them in your host's environment.
# Vite does not copy a .env file into process.env, so for local work load it
# into the shell first:
#   set -a; . ./.env; set +a; npm run dev

# Leave these empty to run on the built-in example data.
# Set both to point the web app at the Outhere Supabase project (London).
# Supabase dashboard: Project Settings > API (Project URL and the anon public key).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# The address members reach this app on, with no trailing slash. Sign in links
# send people back to SITE_URL/auth/callback. Leave empty to use whatever
# address the request came in on (fine locally). In production set it to
# https://weouthere.app: the website passes app paths through to this app, so
# members stay on weouthere.app and requests arrive addressed to the app's host.
# In Supabase: Authentication > URL Configuration, set Site URL to this and add
# SITE_URL/auth/callback (and http://localhost:5173/auth/callback for local
# work) to Redirect URLs.
SITE_URL=

# Where staff links in the sidebar go.
VITE_ADMIN_URL=http://localhost:5174

# Public base URL used in QR codes and share links.
VITE_PUBLIC_URL=https://weouthere.app

# Stripe, server side only. Leave empty and the plan buttons explain instead of charging.
# One recurring GBP price per plan and period: Pro £5.99 a month or £59.99 a
# year, Black £12.99 a month or £129.99 a year (prices live in packages/core/src/mock/seed.ts PLANS).
STRIPE_SECRET_KEY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_BLACK_MONTHLY=
STRIPE_PRICE_BLACK_YEARLY=
# Signing secret of the webhook at SITE_URL/webhooks/stripe (Stripe: Developers >
# Webhooks; events customer.subscription.created, .updated and .deleted).
STRIPE_WEBHOOK_SECRET=
# Lets that webhook write memberships. Server only: never give it a VITE_ name,
# never put it in the admin app or the phone app.
SUPABASE_SERVICE_ROLE_KEY=
