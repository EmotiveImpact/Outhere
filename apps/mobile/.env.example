# OutHere mobile environment variables. Copy to .env and fill in.

# Backend API base URL (the FastAPI server in /backend while it is still in use).
EXPO_PUBLIC_BACKEND_URL=http://localhost:8000

# Mapbox public token for walking route planning. Optional: without it the
# Move tab falls back to the public OSRM router.
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=
