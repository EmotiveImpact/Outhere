{
  "expo": {
    "name": "Outhere",
    "slug": "outhere",
    "scheme": "outhere",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSMotionUsageDescription": "Outhere counts your steps to track your daily movement, streaks and battles.",
        "NSLocationWhenInUseUsageDescription": "Outhere uses your location to map your runs and walks and to check you in at events.",
        "NSCameraUsageDescription": "Outhere uses your camera so you can take a photo for your crew logo.",
        "NSPhotoLibraryUsageDescription": "Outhere uses your photos so you can choose a crew logo.",
        "NSContactsUsageDescription": "Outhere checks which of your contacts are already on Outhere so you can add them. Nothing is stored."
      },
      "bundleIdentifier": "com.outhere.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#07090c"
      },
      "permissions": [
        "android.permission.ACTIVITY_RECOGNITION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.READ_CONTACTS"
      ],
      "package": "com.outhere.app"
    },
    "plugins": [
      [
        "expo-router",
        {
          "sitemap": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#07090c"
        }
      ],
      "expo-audio",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": true,
          "supportsPictureInPicture": true
        }
      ],
      "expo-font",
      "expo-secure-store",
      "expo-web-browser",
      "expo-asset",
      [
        "expo-image-picker",
        {
          "photosPermission": "Outhere uses your photos for stories and your profile picture.",
          "cameraPermission": "Outhere uses the camera for stories and your profile picture."
        }
      ]
    ],
    "web": {
      "bundler": "metro",
      "favicon": "./assets/images/favicon.png"
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "69115b2d-38e8-4c5c-b0bd-02f1ce15f561"
      }
    }
  }
}
