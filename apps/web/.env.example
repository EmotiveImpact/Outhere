# Outhere website settings. Copy to .env.local for local work; set the same
# names in your host's environment variables for production.

# The Outhere Supabase project (Project settings > API). The anon key is meant
# to be public: the website tables are only reachable through db/website.sql's
# functions. Leave both empty to run the site with example figures and
# simulated sign-ups.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Used for canonical links, the sitemap and social cards.
VITE_SITE_URL=https://weouthere.app
