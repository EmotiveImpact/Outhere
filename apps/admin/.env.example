# Outhere HQ is a static site: Vite bakes these in when it builds (import.meta.env),
# so change them and build again. Vite reads this file itself; no extra step.

# Leave these empty to run on the built-in example data, signed in as staff.
# Set both to point Outhere HQ at the Outhere Supabase project (London).
# Use the anon public key only, never the service role key: HQ runs in the
# browser and the database's staff rules decide what it can do.
# With them set, HQ asks for a staff sign in (email link). Anyone signed in
# without a row in the staff table sees "Staff only".
# In Supabase: Authentication > URL Configuration, add this app's address
# (for example https://hq.weouthere.app/ and http://localhost:5174/) to Redirect URLs.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# The member app (apps/app), for "Back to the app" and club page links.
VITE_APP_URL=http://localhost:5173
